{
  "name": "monorise",
  "version": "0.0.0",
  "description": "",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "build": "npm run clear-dist && turbo run build && tsc --build .",
    "build:no-cache": "npm run build -- --cache=local:",
    "clear-dist": "./scripts/clear.sh",
    "release": "npm run build && npm run changeset -- publish",
    "version": "npm run changeset -- version",
    "changeset": "npx @changesets/cli",
    "changeset:dev-start": "npm run changeset -- pre enter dev",
    "changeset:dev-exit": "npm run changeset -- pre exit",
    "start:test-core-env": "docker-compose -f packages/core/docker-compose.test.yml up"
  },
  "workspaces": ["packages/*"],
  "keywords": [],
  "author": "monorise",
  "license": "MIT",
  "dependencies": {
    "@monorise/base": "workspace:*",
    "@monorise/core": "workspace:*",
    "@monorise/react": "workspace:*",
    "@monorise/cli": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.28.1",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^22.13.9",
    "turbo": "^2.4.4",
    "typescript": "^5.1.6"
  },
  "exports": {
    ".": "./dist/index.js",
    "./base": "./packages/base/dist/index.js",
    "./core": "./packages/core/dist/index.js",
    "./react": "./packages/react/dist/index.js",
    "./cli": "./packages/cli/dist/cli.js"
  },
  "files": [
    "dist"
  ]
}
